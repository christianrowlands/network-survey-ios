// Build settings shared by every target. The bundle identifier is set here and
// nowhere else; extensions and test bundles append a suffix to it.
NS_BUNDLE_ID = app.networksurvey.ios
PRODUCT_BUNDLE_IDENTIFIER = $(NS_BUNDLE_ID)

// Signing team. Leave empty here; put DEVELOPMENT_TEAM = <your team ID> in
// Config/Local.xcconfig (gitignored, see Local.xcconfig.example) to run on a device.
DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Automatic

MARKETING_VERSION = 0.1.1
CURRENT_PROJECT_VERSION = 4

IPHONEOS_DEPLOYMENT_TARGET = 18.0
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete

// Crash reporting (Sentry). Empty here, so builds from source never send
// anything; release builds set SENTRY_DSN in Config/Local.xcconfig.
SENTRY_DSN =
// The Sentry environment reports are filed under. The Release workflow sets
// "production" on the archive command line; every other build, including a
// local Release build with a DSN, reports as "local".
SENTRY_ENVIRONMENT = local

// NS Tower Service API key for the tower map. Empty here, so builds from source
// show a "missing key" notice instead of towers; release builds set it in
// Config/Local.xcconfig.
NS_TOWER_API_KEY =

#include? "Local.xcconfig"
